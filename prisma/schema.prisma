datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  STUDENT
  ADMIN
}

enum AssignmentStatus {
  ASSIGNED
  SUBMITTED
}

/// How a test's question paper is delivered.
/// GOOGLE_FORM: answered online in the form itself.
/// GOOGLE_DOC:  a written paper the student reads, answers on paper, and
///              sends back over WhatsApp.
enum TestFormat {
  GOOGLE_FORM
  GOOGLE_DOC
}

// ─────────────────────────────────────────────────────────────
// AUTH & USERS (Auth.js v5 compatible)
// ─────────────────────────────────────────────────────────────

model User {
  id              String       @id @default(cuid())
  name            String?
  email           String       @unique
  emailVerified   DateTime?
  image           String?
  role            Role         @default(STUDENT)
  phone           String?
  className       String?      // e.g. "Class 10", "Class 12"
  profileComplete Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  accounts        Account[]
  sessions        Session[]

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────────────────────
// ASSESSMENT MODELS
// ─────────────────────────────────────────────────────────────

model Test {
  id          String       @id @default(cuid())
  title       String
  subject     String
  description String?      @db.Text
  iconName    String       @default("BookOpen")
  format      TestFormat   @default(GOOGLE_FORM)
  formUrl     String       @db.Text             // Question paper URL. Never exposed to client HTML.
  /// Minutes a student gets once they open the paper. null = untimed.
  durationMinutes Int?
  /// Warn the student when they leave the exam tab, and submit on the third.
  proctored   Boolean      @default(true)
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  assignments Assignment[]

  @@index([active])
}

model Assignment {
  id           String           @id @default(cuid())
  testId       String
  studentEmail String           // Lowercase normalized email (allows pre-assignment before user signs in)
  assignedAt   DateTime         @default(now())
  dueAt        DateTime
  /// Stamped the first time the student opens the paper. The countdown for a
  /// timed test runs from here, so a reload or a second device cannot restart it.
  startedAt    DateTime?
  status       AssignmentStatus @default(ASSIGNED)
  /// True when the timer or the tab guard ended it, not the student.
  autoSubmitted Boolean         @default(false)
  /// How many times this student left the exam tab. Counted on the server so
  /// a reload cannot wipe the tally.
  tabSwitches  Int              @default(0)

  test         Test             @relation(fields: [testId], references: [id], onDelete: Cascade)
  result       Result?

  @@unique([testId, studentEmail])
  @@index([studentEmail])
  @@index([testId])
  @@index([status])
}

model Result {
  id            String     @id @default(cuid())
  assignmentId  String     @unique
  submittedAt   DateTime   @default(now())
  score         Float
  maxScore      Float
  responseEmail String     // Email reported in Google Forms response sheet

  assignment    Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
}
