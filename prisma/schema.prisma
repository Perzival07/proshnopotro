datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  STUDENT
  ADMIN
}

enum AssignmentStatus {
  ASSIGNED
  SUBMITTED
}

/// How a test's question paper is delivered.
/// GOOGLE_FORM: answered online in the form itself.
/// GOOGLE_DOC:  a written paper the student reads and answers on paper.
/// PDF:         a written paper shared as a PDF link on Google Drive.
/// QUESTIONS:   questions written in the portal itself, answered and marked
///              there (see TestSection and Question).
/// Whichever it is, once the attempt ends the student may photograph their
/// answer sheets and upload them once (see AnswerImage).
enum TestFormat {
  GOOGLE_FORM
  GOOGLE_DOC
  PDF
  QUESTIONS
}

/// The kinds of question the portal marks itself. See lib/marking.ts.
enum QuestionType {
  SINGLE
  MULTIPLE
  INTEGER
  DECIMAL
  MATRIX
  SUBJECTIVE
}

/// When a student sees their score and the answers for a QUESTIONS test.
enum ResultRelease {
  /// As soon as they submit.
  INSTANT
  /// Once the tutor releases results for the whole test.
  ON_RELEASE
  /// Once the student's deadline has passed, so nobody still writing sees them.
  AFTER_DEADLINE
}

// ─────────────────────────────────────────────────────────────
// AUTH & USERS (Auth.js v5 compatible)
// ─────────────────────────────────────────────────────────────

model User {
  id              String    @id @default(cuid())
  name            String?
  email           String    @unique
  emailVerified   DateTime?
  image           String?
  role            Role      @default(STUDENT)
  phone           String?
  className       String? // e.g. "Class 10", "Class 12"
  profileComplete Boolean   @default(false)
  /// The secret in a student's read-only progress link for a parent. null =
  /// no link; changing it cuts off the old link.
  parentToken     String?   @unique
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────────────────────
// ASSESSMENT MODELS
// ─────────────────────────────────────────────────────────────

model Test {
  id              String     @id @default(cuid())
  title           String
  subject         String
  description     String?    @db.Text
  iconName        String     @default("BookOpen")
  format          TestFormat @default(GOOGLE_FORM)
  formUrl         String     @db.Text // Question paper URL. Never exposed to client HTML.
  /// A PDF paper uploaded before papers became links-only, stored in Cloudinary
  /// as an authenticated raw file. No longer written; cleared when the test is
  /// next saved.
  paperPublicId   String?
  paperVersion    Int?
  /// The tutor's file name for that old upload.
  paperName       String?
  paperBytes      Int?
  /// Minutes a student gets once they open the paper. null = untimed.
  durationMinutes Int?
  /// Warn the student when they leave the exam tab, and submit on the third.
  proctored       Boolean    @default(true)
  active          Boolean    @default(true)
  /// QUESTIONS tests only: the marking scheme, as lib/marking.ts MarkingScheme.
  markingScheme     Json?
  resultRelease     ResultRelease @default(ON_RELEASE)
  /// Whether students photograph and upload answer sheets after the paper.
  /// Off for a purely objective paper; on for written and subjective ones.
  answerSheets      Boolean       @default(true)
  /// Minutes students get to photograph and upload answer sheets once the
  /// paper closes. Short, so the time after the bell is not writing time;
  /// longer for papers with long written answers.
  uploadMinutes     Int           @default(2)
  /// QUESTIONS tests: show an on-screen calculator (as GATE's CBT does; JEE
  /// Main and NEET do not allow one).
  calculator        Boolean       @default(false)
  /// The name of the paper's second language, as students see it ("हिन्दी"),
  /// when its questions have translations. null = one language only.
  secondLanguage    String?
  /// The syllabus the paper follows, for tagging questions by chapter:
  /// "CBSE", "ICSE", "ISC" ... and "11", "12" ...
  board             String?
  classLevel        String?
  /// A past paper kept in the question bank, never assigned to students.
  bank              Boolean       @default(false)
  /// Bank papers: the year sat, and the exam's own name ("Board exam, Set 1").
  year              Int?
  examName          String?
  /// The series this test belongs to (weekly tests, a test series), for
  /// students' progress across it.
  seriesId          String?
  series            TestSeries?   @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  /// Set when the tutor releases results. Only read for ON_RELEASE tests.
  resultsReleasedAt DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  assignments Assignment[]
  sections    TestSection[]
  passages    Passage[]

  @@index([bank])
  @@index([seriesId])

  @@index([active])
}

model Assignment {
  id                String           @id @default(cuid())
  testId            String
  studentEmail      String // Lowercase normalized email (allows pre-assignment before user signs in)
  assignedAt        DateTime         @default(now())
  dueAt             DateTime
  /// Stamped the first time the student opens the paper. The countdown for a
  /// timed test runs from here, so a reload or a second device cannot restart it.
  startedAt         DateTime?
  status            AssignmentStatus @default(ASSIGNED)
  /// True when the timer or the tab guard ended it, not the student.
  autoSubmitted     Boolean          @default(false)
  /// How many times this student left the exam tab. Counted on the server so
  /// a reload cannot wipe the tally.
  tabSwitches       Int              @default(0)
  /// When the attempt closed -- by the student, the timer or the tab guard.
  /// The one-time answer upload window runs from here.
  endedAt           DateTime?
  /// Stamped when the student's answer photos were saved. Set once: a second
  /// upload is refused while this is filled in. Also stamped, with no pages,
  /// when the student finished without uploading or left the upload page.
  answersUploadedAt DateTime?
  /// The tutor's overall comment on this attempt.
  feedback          String?   @db.Text
  /// When the tutor handed the marked copy back. Until then the student sees
  /// written answers as awaiting marking, however far the marking has got.
  returnedAt        DateTime?

  test         Test          @relation(fields: [testId], references: [id], onDelete: Cascade)
  result       Result?
  answerImages AnswerImage[]
  responses    QuestionResponse[]

  @@unique([testId, studentEmail])
  @@index([studentEmail])
  @@index([testId])
  @@index([status])
}

/// One photographed answer sheet page, stored in Cloudinary as an
/// authenticated asset -- it can only be viewed through a signed URL the
/// server issues to the tutor.
model AnswerImage {
  id           String   @id @default(cuid())
  assignmentId String
  publicId     String
  version      Int
  format       String
  width        Int?
  height       Int?
  bytes        Int?
  /// Page order as the student arranged them.
  position     Int
  /// The tutor's marks drawn on this page -- pen strokes, ticks, crosses and
  /// notes -- in the image's own pixels, as lib/annotations.ts Annotation[].
  /// Drawn over the photo, never into it, so the original is kept.
  annotations  Json?
  createdAt    DateTime @default(now())

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
}

/// A part of a QUESTIONS test: "Physics", "Chemistry", "Section B".
model TestSection {
  id           String  @id @default(cuid())
  testId       String
  title        String
  /// Order within the test, from 0.
  position     Int
  instructions String? @db.Text
  /// "Attempt any N": only the first N attempted questions are marked.
  attemptLimit Int?
  /// Minutes for this section on its own. null = shares the test's time.
  durationMinutes Int?
  /// Overrides the test's marking scheme for this section.
  markingScheme Json?

  test      Test       @relation(fields: [testId], references: [id], onDelete: Cascade)
  questions Question[]

  @@index([testId])
}

/// A passage several questions share (paragraph / comprehension questions).
model Passage {
  id      String @id @default(cuid())
  testId  String
  content String @db.Text
  /// The passage in the test's second language.
  translation String? @db.Text

  test      Test       @relation(fields: [testId], references: [id], onDelete: Cascade)
  questions Question[]

  @@index([testId])
}

/// One question. Text is plain text with $...$ LaTeX and ![](url) images.
model Question {
  id          String       @id @default(cuid())
  sectionId   String
  /// Order within the section, from 0.
  position    Int
  type        QuestionType
  stem        String       @db.Text
  /// [{ id: "A", text: "..." }, ...]; empty for numeric questions. For a
  /// MATRIX question, { rows: [...], columns: [...] }.
  options     Json
  /// The answer key, as lib/marking.ts AnswerKey. Never sent to a student
  /// before their results are released.
  answerKey   Json
  solution    String?      @db.Text
  /// This question's own marks, overriding the scheme when set.
  marksCorrect Float?
  marksWrong   Float?
  /// Dropped from the paper: full marks to everyone who attempted it.
  bonus       Boolean      @default(false)
  /// Internal choice ("Q16 ... OR ..."): questions sharing a group count once.
  choiceGroup String?
  /// The syllabus chapter it tests, and a finer topic within it.
  chapterId   String?
  topic       String?
  /// A video explanation (YouTube or Drive), shown with the solution.
  videoUrl    String?
  /// The question in the test's second language: { stem, options, columns,
  /// solution }, as lib/translation.ts QuestionTranslation. Marked with the
  /// same key.
  translation Json?
  passageId   String?

  section   TestSection        @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  passage   Passage?           @relation(fields: [passageId], references: [id], onDelete: SetNull)
  chapter   Chapter?           @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  responses QuestionResponse[]

  @@index([sectionId])
  @@index([chapterId])
}

/// A run of tests taken over time -- weekly tests, an all-India-style test
/// series -- whose results students follow as one line of progress.
model TestSeries {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?  @db.Text
  createdAt   DateTime @default(now())

  tests Test[]
}

/// One chapter of a board's syllabus for a class and subject, in book order.
/// Loaded from the NCERT presets or pasted in (CISCE), and editable.
model Chapter {
  id         String   @id @default(cuid())
  board      String
  classLevel String
  subject    String
  name       String
  position   Int
  createdAt  DateTime @default(now())

  questions Question[]

  @@unique([board, classLevel, subject, name])
  @@index([board, classLevel, subject])
}

/// A student's answer to one question, saved as they go.
model QuestionResponse {
  id              String   @id @default(cuid())
  assignmentId    String
  questionId      String
  /// An option id, a list of them, or the typed number; null when cleared.
  value           Json?
  markedForReview Boolean  @default(false)
  /// Filled in when the attempt is marked.
  marks           Float?
  status          String?
  /// Written answers: the marks the tutor gave, and a note for the student.
  manualMarks     Float?
  feedback        String?  @db.Text
  /// How long the student had this question on screen, in milliseconds.
  timeSpentMs     Int      @default(0)
  updatedAt       DateTime @updatedAt

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  question   Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, questionId])
  @@index([questionId])
}

model Result {
  id            String   @id @default(cuid())
  assignmentId  String   @unique
  submittedAt   DateTime @default(now())
  score         Float
  maxScore      Float
  responseEmail String // Email reported in Google Forms response sheet

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
}

// ─────────────────────────────────────────────────────────────
// CLASSROOMS & NOTES
// ─────────────────────────────────────────────────────────────

/// A group of students the tutor teaches together.
///
/// Deliberately separate from `User.className`: that field records which year
/// a student is in ("Class 12 - Science"), while a classroom is a batch the
/// tutor actually runs ("Physics Batch A - Mon/Wed"). A student sits in one
/// class and in as many classrooms as the tutor puts them in.
model Classroom {
  id          String   @id @default(cuid())
  name        String   @unique
  subject     String?
  description String?  @db.Text
  iconName    String   @default("GraduationCap")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members ClassroomMember[]
  notes   NoteClassroom[]

  @@index([active])
}

/// One student's place in a classroom.
///
/// Held by email, like Assignment, so the tutor can put a student in a batch
/// before they have ever signed in.
model ClassroomMember {
  id           String   @id @default(cuid())
  classroomId  String
  studentEmail String
  addedAt      DateTime @default(now())

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  @@unique([classroomId, studentEmail])
  @@index([studentEmail])
  @@index([classroomId])
}

/// A set of notes the tutor shares: some files, a link, or both.
model Note {
  id          String    @id @default(cuid())
  title       String
  subject     String
  description String?   @db.Text
  iconName    String    @default("FileText")
  /// An optional companion link -- a lecture recording, a Drive folder.
  linkUrl     String?   @db.Text
  /// When this becomes visible to the students it is shared with. null while
  /// it is still a draft; a future time means every student in the batch sees
  /// it at the same moment, not whenever the tutor happened to finish it.
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  files      NoteFile[]
  classrooms NoteClassroom[]
  students   NoteStudent[]

  @@index([publishedAt])
}

/// One uploaded file belonging to a note, stored in Cloudinary as an
/// authenticated asset -- reachable only through a signed URL the server
/// issues to a student the note is shared with.
model NoteFile {
  id           String   @id @default(cuid())
  noteId       String
  publicId     String
  version      Int
  format       String
  /// Cloudinary's resource type. Always "image": PDFs are shared as links.
  resourceType String   @default("image")
  /// The name the tutor's file had, so the student downloads something
  /// recognisable rather than a public id.
  originalName String
  bytes        Int?
  width        Int?
  height       Int?
  /// Order the tutor arranged the files in.
  position     Int
  createdAt    DateTime @default(now())

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId])
}

/// A note shared with a whole classroom.
model NoteClassroom {
  id          String @id @default(cuid())
  noteId      String
  classroomId String

  note      Note      @relation(fields: [noteId], references: [id], onDelete: Cascade)
  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  @@unique([noteId, classroomId])
  @@index([classroomId])
  @@index([noteId])
}

/// A note shared with one named student, on top of any classrooms.
model NoteStudent {
  id           String @id @default(cuid())
  noteId       String
  studentEmail String

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@unique([noteId, studentEmail])
  @@index([studentEmail])
  @@index([noteId])
}
