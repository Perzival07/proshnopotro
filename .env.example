# ─────────────────────────────────────────────────────────────
# DATABASE (Supabase PostgreSQL)
# ─────────────────────────────────────────────────────────────
# Supabase -> Connect -> ORMs -> Prisma
# 1. Transaction Pooler (Port 6543) - Used for general app queries
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. Session / Direct connection (Port 5432) - Used for migrations
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ─────────────────────────────────────────────────────────────
# AUTHENTICATION (Auth.js v5 / NextAuth)
# ─────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-generated-secret-key-here"

# Set to your production URL on Vercel (e.g. https://your-project.vercel.app) or http://localhost:3000 locally
AUTH_URL="https://your-project.vercel.app"
NEXTAUTH_URL="https://your-project.vercel.app"

# Google OAuth (From Google Cloud Console: Credentials -> OAuth 2.0 Client IDs)
# Authorized redirect URI on Google Console:
# Production: https://your-project.vercel.app/api/auth/callback/google
# Local: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# ─────────────────────────────────────────────────────────────
# ADMIN USERS
# ─────────────────────────────────────────────────────────────
# Comma-separated list of emails with automatic Admin access
ADMIN_EMAILS="admin@example.com,teacher@example.com"
