# The master app's own Postgres database (not any organisation's).
DATABASE_URL=
DIRECT_URL=

# This site's public address, for search engines (canonical links, sitemap).
# Falls back to AUTH_URL.
SITE_URL=

# Auth.js: a random secret, and this site's address.
AUTH_SECRET=
AUTH_URL=http://localhost:3001

# The shared Google OAuth client. Add <this site>/api/auth/callback/google
# as an authorised redirect URI.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated emails that may use /admin.
SUPER_ADMIN_EMAILS=

# Vercel sends this as a bearer token to the daily roster sync (/api/cron/sync).
CRON_SECRET=

# Only for `npm run add-org` (scripts/add-org.ts), run on your computer:
# a Vercel access token (Account Settings -> Tokens), the team id if the
# projects live in a Vercel team, this repo as owner/name, the master's live
# address, and optionally one Cloudinary account every new portal shares.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
GITHUB_REPO=
MASTER_PUBLIC_URL=
SHARED_CLOUDINARY_URL=
