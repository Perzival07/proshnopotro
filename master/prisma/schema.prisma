// The master app's own database: the organisation list, billing and the
// registry of which student emails each organisation has enrolled. It holds
// nothing else about students; their tests, results and profiles stay in each
// organisation's own portal database.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum OrgStatus {
  ACTIVE
  /// The portal shows a "temporarily unavailable" page to everyone.
  SUSPENDED
}

model Organisation {
  id                 String    @id @default(cuid())
  /// The folder name in orgs/ and the portal's ORG environment variable.
  slug               String    @unique
  name               String
  /// The portal's address, e.g. https://classesbykoustav.proshnopotro.in
  portalUrl          String
  status             OrgStatus @default(ACTIVE)
  /// Price per enrolled student per month, in whole rupees.
  pricePerStudentInr Int       @default(0)
  /// Recorded for the super admin; the portal does not enforce it yet.
  maxStudents        Int?
  /// The last day the organisation has paid for, inclusive.
  paidUpTo           DateTime? @db.Date
  /// Shared with the portal as MASTER_SYNC_SECRET; signs requests both ways.
  syncSecret         String
  /// Set by the last successful roster sync from the portal.
  studentCount       Int       @default(0)
  lastSyncAt         DateTime?
  lastSyncError      String?
  notes              String    @default("")
  /// What its portal shows and which features it has (lib/branding.ts
  /// Branding). null = not set here yet: the portal uses its orgs/ folder.
  branding           Json?
  /// The uploaded logo (PNG, JPEG or WebP, at most 1 MB) and its type.
  logoImage          Bytes?
  logoType           String?
  brandingSavedAt    DateTime?
  /// The portal's Vercel deploy hook: called to rebuild it with new branding.
  deployHookUrl      String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  payments  Payment[]
  enrolment Enrolment[]
}

model Payment {
  id         String       @id @default(cuid())
  orgId      String
  org        Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  amountInr  Int
  receivedOn DateTime     @db.Date
  /// UTR, cheque number, wire reference...
  reference  String       @default("")
  note       String       @default("")
  createdAt  DateTime     @default(now())

  @@index([orgId, receivedOn])
}

/// One person in one organisation, copied from its portal: a student, or an
/// owner or tutor. Only students are billed; the hub shows everyone.
model Enrolment {
  orgId String
  org   Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  email String
  /// STUDENT, TUTOR or ADMIN (owner), as in the portal.
  role  String       @default("STUDENT")

  @@id([orgId, email])
  @@index([email])
}
