// The master app's own database: the organisation list, billing and the
// registry of which student emails each organisation has enrolled. It holds
// nothing else about students; their tests, results and profiles stay in each
// organisation's own portal database.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum OrgStatus {
  ACTIVE
  /// The portal shows a "temporarily unavailable" page to everyone.
  SUSPENDED
}

model Organisation {
  id                 String    @id @default(cuid())
  /// The folder name in orgs/ and the portal's ORG environment variable.
  slug               String    @unique
  name               String
  /// The portal's address, e.g. https://classesbykoustav.proshnopotro.in
  portalUrl          String
  status             OrgStatus @default(ACTIVE)
  /// Price per enrolled student per month, in whole rupees.
  pricePerStudentInr Int       @default(0)
  /// Recorded for the super admin; the portal does not enforce it yet.
  maxStudents        Int?
  /// The last day the organisation has paid for, inclusive.
  paidUpTo           DateTime? @db.Date
  /// Shared with the portal as MASTER_SYNC_SECRET; signs requests both ways.
  syncSecret         String
  /// Set by the last successful roster sync from the portal.
  studentCount       Int       @default(0)
  lastSyncAt         DateTime?
  lastSyncError      String?
  notes              String    @default("")
  /// Who Proshnopotro deals with at the organisation. Only the super admin
  /// sees these; the portal's public contact details are in its branding.
  contactName        String    @default("")
  contactEmail       String    @default("")
  contactPhone       String    @default("")
  address            String    @default("")
  /// What its portal shows and which features it has (lib/branding.ts
  /// Branding). null = not set here yet: the portal uses its orgs/ folder.
  branding           Json?
  /// The uploaded logo (PNG, JPEG or WebP, at most 1 MB) and its type.
  logoImage          Bytes?
  logoType           String?
  brandingSavedAt    DateTime?
  /// Listed on the Proshnopotro website's "joined us" section while active.
  showOnWebsite      Boolean   @default(true)
  /// The logo shown there (PNG, JPEG or WebP, at most 1 MB); without one the
  /// branding logo is used, else its initial.
  websiteLogo        Bytes?
  websiteLogoType    String?
  websiteLogoSavedAt DateTime?
  /// The portal's Vercel deploy hook: called to rebuild it with new branding.
  deployHookUrl      String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  payments  Payment[]
  enrolment Enrolment[]
  activity  ActivityLog[]
}

model Payment {
  id         String       @id @default(cuid())
  orgId      String
  org        Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  amountInr  Int
  receivedOn DateTime     @db.Date
  /// UTR, cheque number, wire reference...
  reference  String       @default("")
  note       String       @default("")
  createdAt  DateTime     @default(now())

  @@index([orgId, receivedOn])
}

/// One person in one organisation, copied from its portal: a student, or an
/// owner or tutor. Only students are billed; the hub shows everyone.
model Enrolment {
  orgId String
  org   Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  email String
  /// STUDENT, TUTOR or ADMIN (owner), as in the portal.
  role  String       @default("STUDENT")

  @@id([orgId, email])
  @@index([email])
}

/// Super admins added in the workspace, beside the fixed SUPER_ADMIN_EMAILS.
model SuperAdmin {
  email     String   @id
  addedBy   String
  createdAt DateTime @default(now())
}

/// What each super admin did, newest first on /admin/activity.
model ActivityLog {
  id      String        @id @default(cuid())
  at      DateTime      @default(now())
  /// The super admin's email.
  actor   String
  orgId   String?
  org     Organisation? @relation(fields: [orgId], references: [id], onDelete: SetNull)
  /// Kept as text, so the entry still reads after the organisation is deleted.
  orgName String        @default("")
  action  String
  detail  String        @default("")

  @@index([at])
  @@index([orgId, at])
}

/// Platform-wide settings: one row, id 1.
model PlatformSettings {
  id                        Int      @id @default(1)
  /// Filled in on the "Add organisation" form.
  defaultPricePerStudentInr Int      @default(0)
  /// Shown on every owner's Billing page; empty = the text in lib/site.ts.
  paymentInstructions       String   @default("")
  updatedAt                 DateTime @updatedAt
}
